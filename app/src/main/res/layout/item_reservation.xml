<?xml version="1.0" encoding="utf-8"?>
<!--
  One queued row: a number, a title and a running time. Nothing else.

  It carried Play next / Up / Down / Remove buttons until OP asked for "literally just a
  non-interactive list", and those buttons were also the bug that made every row read BLANK: a
  horizontal LinearLayout measures its wrap_content children first and gives the weighted one
  only the leftovers, so once the four of them outgrew a third-of-a-screen panel the title
  column was allotted zero pixels. With them gone the title has the row to itself.

  focusable stays true and clickable stays false on purpose: focus is the only way a D-pad can
  scroll a long queue, and the row has nothing to answer a press with.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/row_focus"
    android:clickable="false"
    android:focusable="true"
    android:gravity="center_vertical"
    android:minHeight="56dp"
    android:orientation="horizontal"
    android:paddingLeft="16dp"
    android:paddingTop="8dp"
    android:paddingRight="16dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/reservationPosition"
        android:layout_width="36dp"
        android:layout_height="wrap_content"
        android:textColor="@color/accent"
        android:textSize="16sp"
        android:textStyle="bold" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/reservationTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/text_primary"
            android:textSize="17sp" />

        <TextView
            android:id="@+id/reservationDuration"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/text_secondary"
            android:textSize="13sp" />
    </LinearLayout>
</LinearLayout>
